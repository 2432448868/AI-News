{
  "name": "signal-ai-news",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "collect": "node --use-env-proxy scripts/collect.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:backend": "uv run pytest tests/backend -q",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run test:backend && npm test && npm run build",
    "format": "prettier --write src scripts tests *.ts *.json *.html .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.ts *.json *.html .github/workflows/*.yml",
    "build:cloudflare": "tsc --noEmit && vite build --mode cloudflare",
    "dev:cloudflare": "npm run build:cloudflare && uv run pywrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && uv run pywrangler deploy",
    "seed:d1": "node scripts/seed-d1.mjs && wrangler d1 execute signal-ai-news --remote --file .cache/seed.sql",
    "d1:migrate": "wrangler d1 migrations apply signal-ai-news --remote",
    "test:accounts": "npm run build:cloudflare && playwright test --config playwright.account.config.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  }
}

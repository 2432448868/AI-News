{
  "name": "signal-ai-news",
  "main": "backend/entry.py",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["python_workers"],
  "account_id": "babd1f9106669bb17d05f8dcae2c8fb0",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signal-ai-news",
      "database_id": "936136c3-3c76-491a-8e6f-37fec5d235f9"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://signal-ai-news.stock-backend-wkl.workers.dev",
    "COLLECT_SOURCES_PER_RUN": "1"
  },
  "triggers": {
    "crons": ["5 13-23,0 * * *"]
  },
  "migrations": [
    { "tag": "users-v1", "new_sqlite_classes": ["UserAccount"] },
    { "tag": "users-v2", "deleted_classes": ["UserAccount"] }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true
  }
}
